{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "@cerniq/db": ["packages/db/src/index.ts"],
      "@cerniq/db/*": ["packages/db/src/*"],
      "@cerniq/shared": ["packages/shared/src/index.ts"],
      "@cerniq/shared/*": ["packages/shared/src/*"],
      "@cerniq/shared-types": ["packages/shared-types/src/index.ts"],
      "@cerniq/shared-types/*": ["packages/shared-types/src/*"],
      "@cerniq/observability": ["packages/observability/src/index.ts"],
      "@cerniq/observability/*": ["packages/observability/src/*"],
      "@cerniq/worker-shared": ["workers/shared/src/index.ts"],
      "@cerniq/worker-shared/*": ["workers/shared/src/*"]
    }
  },
  "include": ["src/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
