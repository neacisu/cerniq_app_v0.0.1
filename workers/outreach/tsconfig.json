{
  /* Bare specifier: folderul pachetului → package.json "types"/"exports" (dist). Nu mapăm la src (evită TS6059 rootDir la build). */
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@cerniq/observability": ["../../packages/observability"],
      "@cerniq/observability/*": ["../../packages/observability/*"]
    }
  },
  "include": ["src/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
