{
  "name": "@cerniq/worker-shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./health": {
      "types": "./src/health.ts",
      "import": "./dist/health.js"
    },
    "./secrets": {
      "types": "./src/secrets.ts",
      "import": "./dist/secrets.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@cerniq/db": "workspace:*",
    "@cerniq/shared-types": "workspace:*",
    "bullmq": "^5.71.0",
    "ioredis": "^5.10.0",
    "opossum": "^9.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/opossum": "^8.1.9",
    "vitest": "^4.1.0"
  }
}
