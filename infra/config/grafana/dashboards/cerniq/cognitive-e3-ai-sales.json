{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "title": "AI Performance — LLM Tokens Input/min",
      "description": "Total LLM input tokens consumed per minute (prompt length × request rate).",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (model) (rate(cerniq_ai_tokens_input{tenant_id=~\"$tenant_id\"}[$__rate_interval]) * 60)",
          "legendFormat": "input/min — {{model}}",
          "refId": "A"
        },
        {
          "expr": "sum by (model) (rate(cerniq_ai_tokens_output{tenant_id=~\"$tenant_id\"}[$__rate_interval]) * 60)",
          "legendFormat": "output/min — {{model}}",
          "refId": "B"
        }
      ]
    },

    {
      "id": 2,
      "title": "AI Performance — LLM Latency P50/P95/P99",
      "description": "LLM response latency percentiles per model and operation.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, model) (rate(cerniq_ai_llm_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P50 — {{model}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(cerniq_ai_llm_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P95 — {{model}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, model) (rate(cerniq_ai_llm_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P99 — {{model}}",
          "refId": "C"
        }
      ]
    },

    {
      "id": 3,
      "title": "Guardrail Breach Rate — Total breaches/min",
      "description": "Rate of M71-M75 guardrail violations per minute, by type and severity.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 },
          "color": { "mode": "palette-classic" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum by (guardrail_type, severity) (rate(cerniq_ai_guardrail_breaches_total[$__rate_interval]) * 60)",
          "legendFormat": "{{guardrail_type}} — {{severity}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "title": "Guardrail Pass Rate % — per tenant",
      "description": "AI guardrail pass rate percentage (0-100). Below 90% = warning.",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "yellow", "value": 85 },
              { "color": "green", "value": 90 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true },
      "targets": [
        {
          "expr": "avg by (tenant_id) (cerniq_ai_guardrail_pass_rate{tenant_id=~\"$tenant_id\"})",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "title": "AI Regeneration Attempts distribution",
      "description": "Distribution of regeneration attempts after guardrail failures (1=first retry, 3=max).",
      "type": "bargauge",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["sum"] } },
      "targets": [
        {
          "expr": "sum by (guardrail_type) (increase(cerniq_ai_regeneration_attempts_bucket[$__range]))",
          "legendFormat": "{{guardrail_type}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "title": "Negotiation Funnel — Active negotiations by state",
      "description": "Active E3 negotiations per FSM state (D19-D26 pipeline).",
      "type": "barchart",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "xField": "state", "tooltip": { "mode": "single" } },
      "targets": [
        {
          "expr": "sum by (state) (cerniq_negotiation_active{tenant_id=~\"$tenant_id\"})",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 7,
      "title": "Discount Distribution — median % per tenant",
      "description": "Average discount % applied in negotiations. >30% triggers human escalation.",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 50,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 15 },
              { "color": "orange", "value": 30 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, tenant_id) (rate(cerniq_negotiation_discount_avg_bucket{tenant_id=~\"$tenant_id\"}[$__rate_interval])))",
          "legendFormat": "median — {{tenant_id}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 8,
      "title": "Stock Reservations Active",
      "description": "Active stock reservations per tenant (F34 stock:reserve:create).",
      "type": "stat",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum by (tenant_id) (cerniq_stock_reservation_active{tenant_id=~\"$tenant_id\"})",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 9,
      "title": "Fiscal Pipeline — Invoices issued/min by type",
      "description": "Fiscal documents emitted per minute (G39-G45 Oblio pipeline).",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } } },
      "targets": [
        {
          "expr": "sum by (doc_type) (rate(cerniq_fiscal_invoices_total{tenant_id=~\"$tenant_id\"}[$__rate_interval]) * 60)",
          "legendFormat": "{{doc_type}}/min",
          "refId": "A"
        }
      ]
    },

    {
      "id": 10,
      "title": "Fiscal Conversion Rate % — negocieri→facturi",
      "description": "Rata de conversie negocieri în facturi emise. Target: >60%.",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 40 },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 75 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "avg by (tenant_id) (cerniq_fiscal_conversion_rate{tenant_id=~\"$tenant_id\"})",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 11,
      "title": "eFactura Risk — Facturi la risc deadline SPV",
      "description": "Number of eInvoices at risk of missing 5-day ANAF deadline (H48 monitor).",
      "type": "stat",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "sum by (tenant_id) (cerniq_einvoice_deadline_risk_count{tenant_id=~\"$tenant_id\"})",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 12,
      "title": "eFactura Errors — by type",
      "description": "eInvoice ANAF SPV errors per error type (H46-H50 pipeline).",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } },
      "targets": [
        {
          "expr": "sum by (error_type) (rate(cerniq_einvoice_errors_total{tenant_id=~\"$tenant_id\"}[$__rate_interval]) * 60)",
          "legendFormat": "error {{error_type}}/min",
          "refId": "A"
        }
      ]
    },

    {
      "id": 13,
      "title": "MCP Usage — Tool calls/min by tool",
      "description": "MCP tool call rate per tool name and status (L66-L70 MCP layer).",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } } },
      "targets": [
        {
          "expr": "sum by (tool_name, status) (rate(cerniq_mcp_tool_calls_total[$__rate_interval]) * 60)",
          "legendFormat": "{{tool_name}} — {{status}}",
          "refId": "A"
        },
        {
          "expr": "sum by (tenant_id) (cerniq_mcp_session_active{tenant_id=~\"$tenant_id\"})",
          "legendFormat": "sessions active — {{tenant_id}}",
          "refId": "B"
        }
      ]
    },

    {
      "id": 14,
      "title": "LLM Model Usage — Requests/min by model & task type",
      "description": "LLM request rate per model, task type (reasoning/fast/embeddings), selfhosted vs frontier.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } } },
      "targets": [
        {
          "expr": "sum by (model_id, task_type, is_selfhosted) (rate(cerniq_llm_requests_total[$__rate_interval]) * 60)",
          "legendFormat": "{{model_id}} / {{task_type}} selfhosted={{is_selfhosted}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 15,
      "title": "LLM Fallbacks — Frontier model fallback/min",
      "description": "LLM fallback rate to frontier models (Grok-4, GPT-4o) by reason.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2 },
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.5 }] }
        }
      },
      "targets": [
        {
          "expr": "sum by (frontier_model, reason) (rate(cerniq_llm_fallback_total[$__rate_interval]) * 60)",
          "legendFormat": "fallback {{frontier_model}} — reason={{reason}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 16,
      "title": "HITL E3 — Tasks resolved/min",
      "description": "E3 HITL task resolution rate per approval_type and decision (N76-N78).",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } } },
      "targets": [
        {
          "expr": "sum by (approval_type, decision) (rate(cerniq_hitl_tasks_resolved_total{tenant_id=~\"$tenant_id\"}[$__rate_interval]) * 60)",
          "legendFormat": "{{approval_type}} — {{decision}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 17,
      "title": "HITL E3 — Resolution Time P50/P95",
      "description": "Time from HITL task creation to human decision (SLA: 4h = 14400s).",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 7200 },
              { "color": "red", "value": 14400 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, approval_type) (rate(cerniq_hitl_resolution_time_seconds_bucket{tenant_id=~\"$tenant_id\"}[$__rate_interval])))",
          "legendFormat": "P50 — {{approval_type}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, approval_type) (rate(cerniq_hitl_resolution_time_seconds_bucket{tenant_id=~\"$tenant_id\"}[$__rate_interval])))",
          "legendFormat": "P95 — {{approval_type}}",
          "refId": "B"
        }
      ]
    }

  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["cerniq", "e3", "ai-sales", "cognitive", "guardrails", "fiscal", "hitl"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(cerniq_ai_tokens_input, tenant_id)",
        "hide": 0,
        "includeAll": true,
        "label": "Tenant",
        "multi": true,
        "name": "tenant_id",
        "options": [],
        "query": {
          "query": "label_values(cerniq_ai_tokens_input, tenant_id)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "utc",
  "title": "Cerniq E3 — Cognitive AI Sales",
  "uid": "cerniq-e3-cognitive-ai-sales",
  "version": 1
}
