    {
      "id": 5,
      "title": "SLO — rată erori HTTP 5xx (fracție din trafic)",
      "description": "Tinta SLO: sub 0.1% in 5m. Metrice: cerniq_http_requests_total (label status).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "expr": "sum(rate(cerniq_http_requests_total{service=\"cerniq-api\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(cerniq_http_requests_total{service=\"cerniq-api\"}[5m])), 1e-9)",
          "legendFormat": "5xx / all",
          "refId": "A"
        }
      ]
