{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Active Neurons (concurrent jobs)",
      "description": "Sum of cerniq_worker_jobs_active — proxy for neurons currently executing work.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 5, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "expr": "sum(cerniq_worker_jobs_active)", "legendFormat": "active", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "HITL Pending Tasks",
      "description": "Depth of hitl:resume queue (approvals waiting to resume pipeline).",
      "type": "stat",
      "gridPos": { "h": 6, "w": 5, "x": 5, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "expr": "sum(cerniq_worker_queue_depth{queue=\"hitl:resume\"})",
          "legendFormat": "hitl:resume",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pipeline Throughput (jobs/sec)",
      "description": "Processed jobs / sec for pipeline:* queues.",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 10, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 0.01 },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "expr": "sum(rate(cerniq_worker_jobs_processed_total{queue=~\"pipeline:.*\"}[$__rate_interval]))",
          "legendFormat": "pipeline",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "FSM State Distribution (transitions in range)",
      "description": "cerniq_cognitive_fsm_transitions by target state — outreach FSM.",
      "type": "piechart",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "pieType": "pie",
        "tooltip": { "mode": "single", "sort": "none" },
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "list", "placement": "right", "values": [] }
      },
      "targets": [
        {
          "expr": "sum by (to) (increase(cerniq_cognitive_fsm_transitions[$__range]))",
          "legendFormat": "{{ to }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Neuron Fire Rate by Type (approx.)",
      "description": "Grouped rate(processed) by queue family as Sensory / Motor / Deliberative / Reflex proxy (no neuron_type label on metrics).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 12 } }
      },
      "targets": [
        {
          "expr": "sum(rate(cerniq_worker_jobs_processed_total{queue=~\"ingest:.*|webhook:.*\"}[$__rate_interval]))",
          "legendFormat": "Sensory (ingest + webhook)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(cerniq_worker_jobs_processed_total{queue=~\"q:email:.*|q:wa:.*|outreach:.*|wa:.*|email:.*\"}[$__rate_interval]))",
          "legendFormat": "Motor (outreach / channels)",
          "refId": "B"
        },
        {
          "expr": "sum(rate(cerniq_worker_jobs_processed_total{queue=~\"ai:.*\"}[$__rate_interval]))",
          "legendFormat": "Deliberative (ai:*)",
          "refId": "C"
        },
        {
          "expr": "sum(rate(cerniq_worker_jobs_processed_total{queue=~\"normalize:.*|validate:.*|quota:.*\"}[$__rate_interval]))",
          "legendFormat": "Reflex (normalize / validate / quota)",
          "refId": "D"
        }
      ]
    },
    {
      "id": 6,
      "title": "Deliberative Neuron Latency (P50 / P95 / P99)",
      "description": "histogram_quantile on cerniq_worker_job_duration_seconds for ai:* queues.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(cerniq_worker_job_duration_seconds_bucket{queue=~\"ai:.*\"}[$__rate_interval])) by (le))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(cerniq_worker_job_duration_seconds_bucket{queue=~\"ai:.*\"}[$__rate_interval])) by (le))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(cerniq_worker_job_duration_seconds_bucket{queue=~\"ai:.*\"}[$__rate_interval])) by (le))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 7,
      "title": "Data Mutations per Minute",
      "description": "Ingest-path throughput × 60 as a proxy for row-level mutations (no dedicated Prometheus counter for DB data_mutations).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 15 } }
      },
      "targets": [
        {
          "expr": "60 * sum(rate(cerniq_worker_jobs_processed_total{queue=~\"ingest:.*\"}[$__rate_interval]))",
          "legendFormat": "Ingest jobs/min",
          "refId": "A"
        },
        {
          "expr": "60 * sum(rate(cerniq_bronze_contacts_ingested[$__rate_interval]))",
          "legendFormat": "Bronze contacts ingested/min",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Cognitive Event Stream (rate)",
