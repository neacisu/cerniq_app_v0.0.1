      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, task_type) (rate(cerniq_etapa4_hitl_resolution_time_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P50 {{ task_type }}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, task_type) (rate(cerniq_etapa4_hitl_resolution_time_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P95 {{ task_type }}"
        }
