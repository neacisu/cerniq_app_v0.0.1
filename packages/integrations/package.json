{
  "name": "@cerniq/integrations",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./timelinesai": {
      "types": "./src/timelinesai/index.ts",
      "import": "./dist/timelinesai/index.js",
      "default": "./dist/timelinesai/index.js"
    },
    "./instantly": {
      "types": "./src/instantly/index.ts",
      "import": "./dist/instantly/index.js",
      "default": "./dist/instantly/index.js"
    },
    "./resend": {
      "types": "./src/resend/index.ts",
      "import": "./dist/resend/index.js",
      "default": "./dist/resend/index.js"
    },
    "./providers": {
      "types": "./src/providers/index.ts",
      "import": "./dist/providers/index.js",
      "default": "./dist/providers/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cerniq/worker-shared": "workspace:*",
    "bottleneck": "^2.19.5",
    "svix": "^1.90.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
