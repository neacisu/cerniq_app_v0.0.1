{
  "name": "@cerniq/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage:ui-missing-e1-e2": "vitest run __tests__/components/etapa1/ui-missing-e1-e2.test.tsx --config vitest.ui-missing-coverage.config.ts --coverage",
    "test:coverage:app": "vitest run --config vitest.app-coverage.config.ts --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test:watch": "vitest",
    "test:e2e": "PW_DISABLE_TS_ESM=1 playwright test --config playwright.config.cjs"
  },
  "dependencies": {
    "@cerniq/shared": "workspace:*",
    "@cerniq/shared-types": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@refinedev/core": "^5.0.12",
    "@refinedev/react-table": "^6.0.1",
    "@tailwindcss/vite": "4.2.2",
    "@tanstack/react-query": "^5.97.0",
    "@tanstack/react-table": "^8.21.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@xyflow/react": "^12.10.2",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.72.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "4.2.2",
    "vite": "^8.0.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.1",
    "@playwright/test": "1.59.1",
    "@rolldown/plugin-babel": "^0.2.2",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-links": "^10.3.5",
    "@storybook/addon-onboarding": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.0.2",
    "msw": "^2.13.2",
    "msw-storybook-addon": "^2.0.7",
    "storybook": "^10.3.5",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
