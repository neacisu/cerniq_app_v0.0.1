{
  "name": "@cerniq/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @cerniq/db run build",
    "dev": "tsx watch --inspect=0.0.0.0:9229 src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cerniq/integrations": "workspace:*",
    "@cerniq/config": "workspace:*",
    "@cerniq/db": "workspace:*",
    "@cerniq/observability": "workspace:*",
    "@cerniq/shared-types": "workspace:*",
    "@cerniq/worker-shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@types/papaparse": "^5.5.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.71.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.10.0",
    "opossum": "^9.0.0",
    "papaparse": "^5.5.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.5.0",
    "@types/opossum": "^8.1.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
