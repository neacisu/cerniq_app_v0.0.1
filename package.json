{
  "name": "cerniq-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Cerniq.app - B2B Sales Automation Platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run --config vitest.config.ts",
    "test:watch": "vitest",
    "test:coverage": "turbo run test && vitest run --config vitest.config.ts",
    "test:ci": "turbo run test && vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.config.ts",
    "validate": "turbo run lint typecheck test",
    "prepare": "husky",
    "approve-builds": "CI=1 pnpm rebuild",
    "smoke:bullmq-prefix": "node ./infra/scripts/bullmq-prefix-smoketest.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.3.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.13",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "msw": "^2.12.10",
    "prettier": "^3.8.1",
    "turbo": "^2.8.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.18",
    "yaml": "^2.8.2",
    "bullmq": "^5.69.2",
    "ioredis": "^5.9.3",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "overrides": {
      "minimatch": "^10.2.2"
    }
  }
}
