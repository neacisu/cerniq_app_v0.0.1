{
  "name": "cerniq-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Cerniq.app - B2B Sales Automation Platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:generate": "pnpm --filter @cerniq/db db:generate",
    "db:push": "pnpm --filter @cerniq/db db:push",
    "db:studio": "pnpm --filter @cerniq/db db:studio",
    "db:seed": "pnpm --filter @cerniq/db db:seed",
    "db:migrate": "pnpm --filter @cerniq/db db:migrate",
    "diagnostics:inventory": "node ./infra/scripts/build-diagnostics-inventory.mjs",
    "diagnostics:inventory:all": "node ./infra/scripts/build-diagnostics-inventory.mjs",
    "diagnostics:inventory:ts": "node ./infra/scripts/build-diagnostics-inventory.mjs --extensions=.ts,.tsx",
    "diagnostics:problems": "node ./infra/scripts/replay-diagnostics-problems.mjs --input=test-results/diagnostics/workspace-diagnostics.json",
    "diagnostics:sonar:fetch": "node ./infra/scripts/fetch-sonar-issues.mjs --output=test-results/diagnostics/sonar-issues.json",
    "audit:api-routes": "node ./infra/scripts/audit-api-routes.mjs",
    "audit:api-routes:write": "node ./infra/scripts/audit-api-routes.mjs --write=docs/generated/api-routes-inventory.json",
    "audit:prometheus-metrics": "node ./infra/scripts/audit-prometheus-metrics.mjs",
    "audit:prometheus-metrics:write": "node ./infra/scripts/audit-prometheus-metrics.mjs --write=docs/generated/prometheus-metrics-inventory.json",
    "verify:sonar-config": "node ./infra/scripts/verify-sonar-config.mjs",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "vitest",
    "test:coverage": "turbo run test -- --coverage",
    "test:ci": "node ./infra/scripts/run-vitest-ci.mjs",
    "test:e2e": "playwright test",
    "test:load:etapa1": "k6 run ./tests/performance/etapa1-throughput.k6.js",
    "validate": "turbo run lint typecheck test",
    "prepare": "husky",
    "approve-builds": "pnpm approve-builds",
    "smoke:bullmq-prefix": "node ./infra/scripts/bullmq-prefix-smoketest.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.3.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-v8": "^4.1.0",
    "bullmq": "5.71.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "husky": "^9.1.7",
    "ioredis": "^5.10.0",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "msw": "^2.12.10",
    "prom-client": "^15.1.3",
    "prettier": "^3.8.1",
    "turbo": "^2.8.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=25.8.1",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "minimatch": "^10.2.3",
      "rollup": "^4.59.0",
      "esbuild": ">=0.25.0",
      "ioredis": "^5.10.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-react-hooks>eslint": "10"
      }
    },
    "allowedDeprecatedVersions": {
      "@esbuild-kit/core-utils": "3",
      "@esbuild-kit/esm-loader": "2",
      "glob": "*",
      "fstream": "1",
      "inflight": "1",
      "lodash.isequal": "4",
      "rimraf": "2"
    }
  },
  "dependencies": {
    "fastify": "5.8.2"
  }
}
