{
  "name": "cerniq-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Cerniq.app - B2B Sales Automation Platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:generate": "pnpm --filter @cerniq/db db:generate",
    "db:push": "pnpm --filter @cerniq/db db:push",
    "db:studio": "pnpm --filter @cerniq/db db:studio",
    "db:seed": "pnpm --filter @cerniq/db db:seed",
    "db:migrate": "pnpm --filter @cerniq/db db:migrate",
    "diagnostics:inventory": "node ./infra/scripts/build-diagnostics-inventory.mjs",
    "diagnostics:inventory:all": "node ./infra/scripts/build-diagnostics-inventory.mjs",
    "diagnostics:inventory:ts": "node ./infra/scripts/build-diagnostics-inventory.mjs --extensions=.ts,.tsx",
    "diagnostics:problems": "node ./infra/scripts/replay-diagnostics-problems.mjs --input=test-results/diagnostics/workspace-diagnostics.json",
    "diagnostics:sonar:fetch": "node ./infra/scripts/fetch-sonar-issues.mjs --output=test-results/diagnostics/sonar-issues.json",
    "audit:api-routes": "node ./infra/scripts/audit-api-routes.mjs",
    "audit:api-routes:write": "node ./infra/scripts/audit-api-routes.mjs --write=docs/generated/api-routes-inventory.json",
    "audit:http-route-manifest": "python3 ./infra/scripts/verify_http_route_manifest.py",
    "audit:http-route-manifest:write": "python3 ./infra/scripts/build_http_route_manifest.py --write=docs/generated/api-http-route-manifest.json",
    "audit:http-trace-smoke-matrix:write": "python3 ./infra/scripts/build_http_trace_smoke_matrix.py --write=docs/generated/http-trace-smoke-matrix.json",
    "audit:http-trace-smoke-matrix:verify": "python3 ./infra/scripts/build_http_trace_smoke_matrix.py --write=docs/generated/http-trace-smoke-matrix.json --verify",
    "audit:http-metric-labels": "node ./infra/scripts/audit_http_metric_label_allowlist.mjs",
    "audit:openapi-route-parity": "python3 ./infra/scripts/compare_route_manifest_openapi.py",
    "audit:prometheus-metrics": "node ./infra/scripts/audit-prometheus-metrics.mjs",
    "audit:prometheus-metrics:write": "node ./infra/scripts/audit-prometheus-metrics.mjs --write=docs/generated/prometheus-metrics-inventory.json",
    "audit:ui-button-inventory:write": "python3 ./scripts/generate-ui-button-click-inventory.py",
    "verify:sonar-config": "node ./infra/scripts/verify-sonar-config.mjs",
    "lint": "turbo run lint",
    "lint:md": "markdownlint-cli2 \":.github/PULL_REQUEST_TEMPLATE.md\" \":README.md\" \":apps/monitoring-api/README.md\" \":docs/adr/ADR Etapa 0/ADR-0022-Port-Allocation-Strategy.md\" \":docs/infrastructure/ci-cd-pipeline.md\" \":docs/developer-guide/openapi-swagger-parity.md\" \":docs/developer-guide/supply-chain-dependabot.md\" \":docs/developer-guide/refine-auth-data-provider.md\" \":docs/developer-guide/security-sse-brain-token.md\" \":docs/infrastructure/infra-scripts-inventory.md\" \":docs/workers/e5-nurturing-python-contract.md\" \":docs/services/python-sidecars-contract.md\" \":docs/ui-ux/README.md\"",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "vitest",
    "test:coverage": "turbo run test -- --coverage",
    "verify:coverage-policy": "node ./infra/scripts/verify-vitest-coverage-policy.mjs",
    "test:ci": "node ./infra/scripts/run-vitest-ci.mjs",
    "test:e2e": "playwright test",
    "test:infra": "pnpm exec vitest run tests/e2e/infrastructure --reporter=dot",
    "test:pgtap": "bash infra/scripts/run-pgtap.sh",
    "test:load:etapa1": "k6 run ./tests/performance/etapa1-throughput.k6.js",
    "validate": "turbo run lint typecheck test",
    "prepare": "husky",
    "approve-builds": "pnpm approve-builds",
    "smoke:bullmq-prefix": "node ./infra/scripts/bullmq-prefix-smoketest.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@cerniq/db": "workspace:*",
    "@cerniq/worker-shared": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/otel": "^0.18.1",
    "@fastify/rate-limit": "^10.3.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/instrumentation": "^0.214.0",
    "@opentelemetry/instrumentation-http": "^0.214.0",
    "@playwright/test": "^1.59.1",
    "@rolldown/plugin-babel": "^0.2.2",
    "@tailwindcss/vite": "4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "bullmq": "5.73.3",
    "drizzle-orm": "0.45.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fastify-plugin": "^5.1.0",
    "husky": "^9.1.7",
    "ioredis": "^5.10.1",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.22.0",
    "msw": "^2.13.2",
    "pino": "^10.3.1",
    "prettier": "^3.8.2",
    "prom-client": "^15.1.3",
    "turbo": "^2.9.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.8",
    "vitest": "^4.1.4",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=25.8.1",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "minimatch": "^10.2.3",
      "rollup": "^4.59.0",
      "esbuild": ">=0.25.0",
      "ioredis": "^5.10.1",
      "drizzle-orm": "0.45.2",
      "postgres": "3.4.9",
      "@opentelemetry/api": "1.9.1"
    },
    "packageExtensions": {
      "drizzle-orm": {
        "peerDependenciesMeta": {
          "@types/pg": {
            "optional": false
          }
        }
      }
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-react-hooks>eslint": "10"
      }
    },
    "allowedDeprecatedVersions": {
      "@esbuild-kit/core-utils": "3",
      "@esbuild-kit/esm-loader": "2",
      "glob": "*",
      "fstream": "1",
      "inflight": "1",
      "lodash.isequal": "4",
      "rimraf": "2"
    }
  },
  "dependencies": {
    "fastify": "5.8.4"
  }
}
