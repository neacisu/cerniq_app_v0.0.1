+/**
+ * Shim ESM pentru Node + tsx: importuri statice din `@opentelemetry/api` trebuie să rezolve
+ * la binding-uri reale (nu doar `export *` din CJS — lipsesc clase precum `DiagConsoleLogger`).
+ */
+import cjs from "./build/src/index.js";
+
+export default cjs;
+
+export const {
+  baggageEntryMetadataFromString,
+  createContextKey,
+  ROOT_CONTEXT,
+  DiagConsoleLogger,
+  DiagLogLevel,
+  createNoopMeter,
+  ValueType,
+  defaultTextMapGetter,
+  defaultTextMapSetter,
+  ProxyTracer,
+  ProxyTracerProvider,
+  SamplingDecision,
+  SpanKind,
+  SpanStatusCode,
+  TraceFlags,
+  createTraceState,
+  isSpanContextValid,
+  isValidTraceId,
+  isValidSpanId,
+  INVALID_SPANID,
+  INVALID_TRACEID,
+  INVALID_SPAN_CONTEXT,
+  context,
+  diag,
+  metrics,
+  propagation,
+  trace,
+} = cjs;
