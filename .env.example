# =============================================================================
# Cerniq.app — Environment Variables
# Copy to .env and customize for your environment
# =============================================================================

# --- General ---
NODE_ENV=development
LOG_LEVEL=debug

# --- API Server ---
API_PORT=64010
JWT_SECRET=change-me-minimum-32-characters-long-secret
JWT_EXPIRES_IN=24h
CORS_ORIGIN=*
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# --- Database (via PgBouncer) ---
DATABASE_URL=postgresql://cerniq:cerniq_password@localhost:6432/cerniq
# Direct connection (bypassing PgBouncer, for migrations only)
DATABASE_DIRECT_URL=postgresql://cerniq:cerniq_password@10.0.1.107:5432/cerniq

# --- Redis (shared on orchestrator) ---
REDIS_URL=redis://default:redis_password@10.0.1.10:6379

# --- OpenBao (secrets management) ---
OPENBAO_ADDR=https://openbao.geniuserp.cloud:8200
OPENBAO_TOKEN=hvs.change-me

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:64071
OTEL_SERVICE_NAME=cerniq-api

# --- Monitoring API ---
MONITORING_PORT=64080
ADMIN_KEY=change-me-admin-key

# --- External APIs (Etapa 1+) ---
# ANAF_API_URL=https://webservicesp.anaf.ro/PlatitorTvaRest/api/v8/ws/tva
# TERMENE_API_KEY=
# HUNTER_API_KEY=
# TIMELINESAI_API_KEY=
# INSTANTLY_API_KEY=
# RESEND_API_KEY=
# XAI_API_KEY=
