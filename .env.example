# =============================================================================
# Cerniq.app — Environment Variables
# Copy to .env and customize for your environment
# =============================================================================

# --- General ---
NODE_ENV=development
LOG_LEVEL=debug

# --- API Server ---
API_PORT=64010
# JWT: use minimum 32-char secrets. Lifetime is 15 minutes (refresh via JWT_REFRESH_SECRET).
JWT_SECRET=change-me-minimum-32-characters-long-secret
JWT_REFRESH_SECRET=change-me-minimum-32-characters-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=cerniq.app
JWT_AUDIENCE=cerniq-api
CORS_ORIGIN=http://localhost:64000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
# Content Security Policy (set strict value for staging/prod)
CSP_POLICY=default-src 'self'

# --- Database (via PgBouncer) ---
DATABASE_URL=postgresql://cerniq:cerniq_password@localhost:6432/cerniq
# Direct connection (bypassing PgBouncer, for migrations only)
DATABASE_DIRECT_URL=postgresql://cerniq:cerniq_password@10.0.1.107:5432/cerniq

# --- Redis (shared on orchestrator) ---
REDIS_URL=redis://default:redis_password@10.0.1.10:6379
REDIS_PREFIX=cerniq
REDIS_PASSWORD=redis_password
# BullMQ: obligatoriu pentru workers și API (createQueue); același namespace pe toate serviciile care partajează cozi.
BULLMQ_PREFIX=cerniq
CERNIQ_ENV=development
DB_POOL_SIZE=10
METRICS_ALLOW_CIDR=10.0.0.0/16,127.0.0.1,::1
POSTGRES_USER=cerniq
POSTGRES_PASSWORD=change-me

# --- OpenBao (secrets management) ---
OPENBAO_ADDR=https://openbao.example.com:8200
OPENBAO_TOKEN=hvs.change-me

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:64071
OTEL_SERVICE_NAME=cerniq-api

# --- Monitoring API ---
MONITORING_PORT=64080
ADMIN_KEY=change-me-admin-key

# --- Workers ---
WORKER_CONCURRENCY=5
WORKER_AI_QUEUE=cerniq-ai
WORKER_ENRICHMENT_QUEUE=cerniq-enrichment
WORKER_OUTREACH_QUEUE=cerniq-outreach
SECRETS_PATH=/secrets/workers.env
# File upload directory for Bronze imports
IMPORT_UPLOAD_DIR=./data/imports
# Max import file size in bytes (default 50MB)
IMPORT_MAX_FILE_SIZE_BYTES=52428800

# --- Python Services (Etapa 1+) ---
PYTHON_MCP_PORT=64078
PYTHON_GRAPH_PORT=64077
PYTHON_PDF_PORT=64076
PYTHON_DOCUMENT_PORT=64075

# --- Admin Dashboard ---
ADMIN_DASHBOARD_PORT=64012

# --- Web ---
WEB_PORT=64000

# --- External APIs (Etapa 1: Enrichment) ---
# ANAF
ANAF_API_URL=https://webservicesp.anaf.ro/PlatitorTvaRest/api/v8/ws/tva
# ONRC
# ONRC_API_KEY=
# Termene.ro
# TERMENE_API_KEY=
# Hunter.io (email discovery, 15 req/sec)
# HUNTER_API_KEY=
# ZeroBounce (email validation, 10 req/sec)
# ZEROBOUNCE_API_KEY=
# HLR Lookup (phone validation)
# HLR_API_KEY=
# Bing Search API (website finder, 3 req/sec)
# BING_SEARCH_API_KEY=
# Clearbit (email enrichment)
# CLEARBIT_API_KEY=
# FullContact (email enrichment)
# FULLCONTACT_API_KEY=
# xAI / Grok (AI structuring, 60 req/min)
# XAI_API_KEY=
# DAJ / ANIF scraping base URL
# DAJ_BASE_URL=https://daj.madr.ro
# ANIF_BASE_URL=https://anif.ro
# APIA scraping
# APIA_BASE_URL=https://apia.org.ro
# Nominatim geocoding (50 req/sec - free OSM service)
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# --- External APIs (Etapa 2 — Cold Outreach) ---
# TimelinesAI (WhatsApp)
# TIMELINESAI_API_URL=https://api.timelines.ai
# TIMELINESAI_API_KEY=
# TIMELINESAI_WEBHOOK_SECRET=
# Instantly (email rece)
# INSTANTLY_API_URL=https://api.instantly.ai/api/v1
# INSTANTLY_API_KEY=
# INSTANTLY_WEBHOOK_SECRET=
# Resend (email cald + webhooks Svix)
# RESEND_API_URL=https://api.resend.com
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
