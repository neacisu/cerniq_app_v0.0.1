  "pgtapPolicy": {
    "roleInPyramid": "Strat SQL: constrângeri, indexuri critice, RLS/policies unde există — complement la integrarea Drizzle/Testcontainers.",
    "entryScript": "infra/scripts/run-pgtap.sh",
    "rootCommand": "pnpm test:pgtap",
    "ciBehavior": "În job-ul `test` din `.github/workflows/ci-pr.yml`: după `pnpm db:migrate`, dacă extensia `pgtap` e în `pg_available_extensions`, se creează extensia și rulează `run-pgtap.sh`; altfel pasul se omite cu notice (imaginea postgis/postgis fără pgtap).",
    "extensionMissingProcedure": "Nu eșuează PR-ul din cauza absenței pgtap în cluster; în medii cu pgtap (dev/staging) rularea `pnpm test:pgtap` rămâne obligatorie înainte de merge când există modificări în `tests/pgtap/*.sql` sau migrații sensibile — review uman.",
    "testDataPolicy": "Testele SQL folosesc aceeași `DATABASE_URL` ca migrarea din CI; nu introduceți date de producție; păstrați fișierele idempotente acolo unde e fezabil.",
    "owner": "platform",
    "lastReviewed": "2026-04-11",
    "relatedAdrSections": ["ADR-0029 — pgTAP", "ADR-0029 — piramidă"]
  },
  "workersBullMQPolicy": {
    "tier": "B",
    "requiredSignals": [
      "Suite Vitest pe codul workerului cu aserțiuni pe comportament (nu doar „job-ul a rulat”).",
      "`pnpm smoke:bullmq-prefix` ca verificare de mediu Redis/prefix cozi unde e înregistrat în intrarea din registru.",
      "La logică de retry/idempotență: teste care demonstrează ordinea așteptată sau absența efectelor duplicate, nu doar apelul handlerului."
    ],
    "antiPatterns": [
      "Mock total I/O fără verdicte pe ieșire sau pe starea persistată.",
      "Integrare care verifică doar că processorul s-a invocat, fără invariante de business."
    ],
    "owner": "workers",
    "lastReviewed": "2026-04-11",
    "relatedAdrSections": ["ADR-0029 — cozi / testare reală"]
  }
