# =============================================================================
# Docker Build Context — Cerniq.app
# Exclude non-essential files to speed up builds and prevent
# host node_modules from overwriting pnpm-created symlinks.
# =============================================================================

**/node_modules
**/.git
**/.gitignore
**/.env
**/.env.*
**/dist
**/.turbo
**/.next
**/.vite
**/.vite-temp
**/coverage
**/*.log
**/npm-debug.log*

# IDE
**/.vscode
**/.cursor
**/.idea

# Documentation (not needed in images)
docs/
*.md
!README.md
LICENSE

# Tests (not needed in production images)
**/__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/vitest.config.ts
vitest.workspace.ts

# Infrastructure scripts (not needed in app images)
infra/scripts/
infra/config/
.github/
.husky/
.trivyignore

# Secrets
secrets/
